# ############################################################################
# CLUSTER-SCOPED AND SHARED BY BOTH ENVIRONMENTS.
# An upgrade here is a PROD CHANGE. If another team already runs VSO on this
# cluster, DELETE this file rather than syncing it.
# ############################################################################
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: archi-crab-vault-secrets-operator
  namespace: argocd
  annotations: {argocd.argoproj.io/sync-wave: "-7"}
spec:
  project: archi-crab
  source:
    chart: vault-secrets-operator
    repoURL: https://helm.releases.hashicorp.com
    targetRevision: "TODO_PIN_VSO"
  destination: {server: https://kubernetes.default.svc, namespace: vault-secrets-operator}
  syncPolicy:
    automated: {prune: true, selfHeal: true}
    syncOptions: [CreateNamespace=true]
